@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
title Africa Delivery — System Context (MVP)
Person(buyer, "Покупатель", "Выбирает и заказывает товары")
Person(seller, "Продавец", "Предоставляет товары")
Person(ceo, "CEO", "Контролирует показатели MVP")
System(market, "Africa Delivery", "Каталог, заказы, платежи, уведомления, аналитика")
System_Ext(mpesa, "M-Pesa", "Платежи")
System_Ext(flutter, "Flutterwave", "Платежи")
System_Ext(paystack, "Paystack", "Альтернативный платёжный провайдер")
System_Ext(sendbox, "Sendbox", "Логистический партнёр")
System_Ext(sendy, "Sendy", "Логистический партнёр")
System_Ext(wa, "WhatsApp Business API", "Сообщения")
System_Ext(sms, "SMS/USSD-шлюз", "Уведомления и потенциальные офлайн-сценарии")
Rel(buyer, market, "Смотрит каталог, создаёт и оплачивает заказ", "HTTPS")
Rel(seller, market, "Передаёт информацию о товарах", "Интерфейс требует уточнения")
Rel(ceo, market, "Просматривает базовые показатели", "HTTPS")
Rel(market, mpesa, "Инициирует платежи, получает статусы", "API")
Rel(market, flutter, "Инициирует платежи, получает статусы", "API")
Rel(market, paystack, "Потенциальные платежи после согласования", "API")
Rel(market, sendbox, "Передаёт заявку на доставку, получает статус", "API")
Rel(market, sendy, "Передаёт заявку на доставку, получает статус", "API")
Rel(market, wa, "Отправляет уведомления", "API")
Rel(market, sms, "Отправляет SMS, USSD при согласовании", "API")
@enduml